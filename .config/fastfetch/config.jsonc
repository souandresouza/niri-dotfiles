{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": "  "
    },
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/ascii.txt",
        "padding": {
            "top": 0,
            "left": 1,
            "right": 2
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "shell",
        "wm",
        "terminal",
        "cpu",
        "memory",
        "disk",
        "packages",
        "break",
        "colors"
    ]
}
