#!/usr/bin/env bash
# Recarrega as cores em todas as janelas do kitty.
#
# Recarrega as cores em todas as janelas do kitty apos o pywal/run-scripts.sh
# escrever ~/.config/kitty/colors-kitty.conf. O kitty so aplica cores novas em
# processo vivo; por isso percorre os sockets unix de todas as instancias em
# vez de recarregar so a janela ativa.
#
# O SIGUSR1 do script pywal antigo era fallback para quando o remote control
# nao respondia — mantido aqui porque ainda vale.

set -u

reloaded=0

for s in /tmp/kitty-*; do
    [[ -S "$s" ]] || continue
    kitty @ --to "unix:$s" ls >/dev/null 2>&1 || continue
    kitty @ --to "unix:$s" load-config >/dev/null 2>&1 || continue
    reloaded=$((reloaded + 1))
done

# Nenhum socket respondeu: tenta o caminho antigo.
if [[ $reloaded -eq 0 ]] && pgrep -x kitty >/dev/null 2>&1; then
    pkill -SIGUSR1 -x kitty 2>/dev/null || true
fi