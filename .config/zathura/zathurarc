
set adjust-open "best-fit"

set pages-per-row 1

set scroll-page-aware "true"
set smooth-scroll "true"
set scroll-full-overlap 0.01
set scroll-step 100

set zoom-min 10
set guioptions "s"

set font "inconsolata 15"
set default-bg "#0b0f17"
set default-fg "#8faadc"

set statusbar-fg "#8faadc"
set statusbar-bg "#0b0f17"

set inputbar-bg "#0b0f17"
set inputbar-fg "#c57241"

set highlight-color "#19315e80"
set highlight-active-color "#111e3780"

set recolor true
set recolor-lightcolor "#8faadc"
set recolor-darkcolor "#0b0f17"
set recolor-reverse-video true
#set recolor-keephue true

set render-loading false
set scroll-step 50
unmap f
map f toggle_fullscreen
map [fullscreen] f toggle_fullscreen
